# DocGraph Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit `.env` to git — it contains secrets.
# `.env.example` IS committed as a template for other developers.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the DocGraph Python backend (FastAPI / Uvicorn)
# No trailing slash — paths in env.ts include their own leading slash
VITE_API_BASE_URL=http://localhost:8000
