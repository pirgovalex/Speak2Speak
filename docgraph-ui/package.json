{
  "name": "docgraph-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "solid-js": "^1.8.7"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.1.2",
    "postcss": "^8.4.38",
    "simple-git-hooks": "^2.13.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^4.1.9"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.jsx": "node -e 'console.error(\"jsx files are not allowed in src/\"); process.exit(1)'",
    "src/**/*.js": "node -e 'console.error(\"plain js files are not allowed in src/\"); process.exit(1)'"
  }
}
